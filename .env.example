# Copy to .env for local development. Never commit a filled-in .env.
INV_ENV=dev

# Database. The application connects as the non-owner role inv_app in a
# deployment; migrations run as the owner.
INV_DATABASE_URL=postgresql+psycopg://invowner:CHANGE_ME@localhost:55432/invdev
INV_TEST_DATABASE_URL=postgresql+psycopg://invowner:CHANGE_ME@localhost:55432/invdev

# Partition management (CR-06).
INV_PARTITION_LEAD_MONTHS=3
INV_PARTITION_MINIMUM_MONTHS=1

# Node liveness. AC-02 targets detection within 60 seconds.
INV_HEARTBEAT_TIMEOUT_SECONDS=60
INV_BOOTSTRAP_TOKEN_TTL_SECONDS=900

# Pagination (PLAN-BACKEND-001).
INV_PAGE_LIMIT_DEFAULT=50
INV_PAGE_LIMIT_MAX=200

# --- Owned by S01, deliberately unset ---------------------------------------
# Leaving these blank is the correct state until S01-BE and S01-ST decide them.
# /v1/health reports them as unresolvedSettings rather than defaulting.
# INV_OIDC_ISSUER=
# INV_OIDC_AUDIENCE=
# INV_OIDC_JWKS_URL=
# INV_NODE_MTLS_CA_BUNDLE=
# INV_OBJECT_STORE_ENDPOINT=
