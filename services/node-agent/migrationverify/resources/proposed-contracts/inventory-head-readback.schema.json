{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "saintvision-migration-proof-envelope:1"
        },
        "contractId": {
          "const": "saintvision-proof-inventory-head-readback:1"
        },
        "typedSubject": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "inventory-head-readback"
            },
            "cohortId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\u0000]*$"
            },
            "presence": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\u0000]*$"
            },
            "envelopeSHA256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "registrationSHA256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "kind",
            "cohortId",
            "presence",
            "envelopeSHA256",
            "registrationSHA256"
          ]
        },
        "observedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$",
          "format": "date-time"
        },
        "validUntil": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$",
          "format": "date-time"
        },
        "migrationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000]*$"
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000]*$"
        }
      },
      "required": [
        "schemaVersion",
        "contractId",
        "typedSubject",
        "observedAt",
        "validUntil",
        "migrationId",
        "operationId"
      ]
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "const": "cp-inventory"
        },
        "keySPKISHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signatureHex": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        }
      },
      "required": [
        "role",
        "keySPKISHA256",
        "signatureHex"
      ]
    }
  },
  "required": [
    "body",
    "signer"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet5-k1-proposal.invalid/inventory-head-readback.schema.json"
}
