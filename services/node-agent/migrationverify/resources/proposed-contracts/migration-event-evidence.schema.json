{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "saintvision-migration-proof-envelope:1"
        },
        "contractId": {
          "const": "saintvision-proof-migration-event-evidence:1"
        },
        "typedSubject": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "migration-event-evidence"
            },
            "planEnvelopeSHA256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "migrationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\u0000]*$"
            },
            "operationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\u0000]*$"
            },
            "sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "phase": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\u0000]*$"
            },
            "method": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\u0000]*$"
            },
            "recordKind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\u0000]*$"
            }
          },
          "required": [
            "kind",
            "planEnvelopeSHA256",
            "migrationId",
            "operationId",
            "sequence",
            "phase",
            "method",
            "recordKind"
          ]
        },
        "observedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$",
          "format": "date-time"
        },
        "validUntil": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$",
          "format": "date-time"
        },
        "migrationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000]*$"
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000]*$"
        }
      },
      "required": [
        "schemaVersion",
        "contractId",
        "typedSubject",
        "observedAt",
        "validUntil",
        "migrationId",
        "operationId"
      ]
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "const": "host-helper"
        },
        "keySPKISHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signatureHex": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        }
      },
      "required": [
        "role",
        "keySPKISHA256",
        "signatureHex"
      ]
    }
  },
  "required": [
    "body",
    "signer"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet5-k1-proposal.invalid/migration-event-evidence.schema.json"
}
