  "requiredVerifier": "pretrusted:node-floor-v2:1",
  "freshness": "fresh",
  "status": "PROPOSED_CODE_REVIEW_REQUIRED",
  "codec": "native-m2-v2",
  "schemaFile": "node-floor-v2.schema.json",
  "schemaSHA256": "14f09f682837e8abfd84cfafc6acde88734e0d6480fec4098c0c4a60230fbf01",
  "subjectSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "kind": {
        "const": "node-floor-v2"
