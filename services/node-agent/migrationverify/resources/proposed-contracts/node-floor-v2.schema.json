{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "certificateDER_SHA256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "peerPolicySHA256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "floorSHA256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "journalIdentitySHA256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "servingProcessSHA256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "servingExecutableSHA256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000]*$"
    },
    "nodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000]*$"
    },
    "recoveryEpoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000]*$"
    },
    "schemaVersion": {
      "const": "saintvision-node-peer-policy-floor:2"
    },
    "observedAt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "peerPolicyVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "journalUID": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "servingPID": {
      "const": 1
    },
    "plainServingProcess": {
      "const": true
    },
    "nodeSignature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  },
  "required": [
    "nonce",
    "certificateDER_SHA256",
    "peerPolicySHA256",
    "floorSHA256",
    "journalIdentitySHA256",
    "servingProcessSHA256",
    "servingExecutableSHA256",
    "tenantId",
    "nodeId",
    "recoveryEpoch",
    "schemaVersion",
    "observedAt",
    "peerPolicyVersion",
    "journalUID",
    "servingPID",
    "plainServingProcess",
    "nodeSignature"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet5-k1-proposal.invalid/node-floor-v2.schema.json"
}
