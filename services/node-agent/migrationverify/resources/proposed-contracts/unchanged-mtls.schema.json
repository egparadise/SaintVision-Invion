{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "saintvision-migration-proof-envelope:1"
        },
        "contractId": {
          "const": "saintvision-proof-unchanged-mtls:1"
        },
        "typedSubject": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unchanged-mtls"
            },
            "scope": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "tenantId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^\\u0000]*$"
                },
                "nodeId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^\\u0000]*$"
                },
                "recoveryEpoch": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^\\u0000]*$"
                }
              },
              "required": [
                "tenantId",
                "nodeId",
                "recoveryEpoch"
              ]
            },
            "channelVersion": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "nodeCertificateDERSHA256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "controlCertificateDERSHA256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "endpoint": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\u0000]*$"
            },
            "authoritySHA256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "kind",
            "scope",
            "channelVersion",
            "nodeCertificateDERSHA256",
            "controlCertificateDERSHA256",
            "endpoint",
            "authoritySHA256"
          ]
        },
        "observedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$",
          "format": "date-time"
        },
        "validUntil": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$",
          "format": "date-time"
        },
        "migrationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000]*$"
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000]*$"
        }
      },
      "required": [
        "schemaVersion",
        "contractId",
        "typedSubject",
        "observedAt",
        "validUntil",
        "migrationId",
        "operationId"
      ]
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "const": "host-helper"
        },
        "keySPKISHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signatureHex": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        }
      },
      "required": [
        "role",
        "keySPKISHA256",
        "signatureHex"
      ]
    }
  },
  "required": [
    "body",
    "signer"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet5-k1-proposal.invalid/unchanged-mtls.schema.json"
}
