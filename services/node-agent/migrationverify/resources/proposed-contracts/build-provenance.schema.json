{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "saintvision-migration-proof-envelope:1"
        },
        "contractId": {
          "const": "saintvision-proof-build-provenance:1"
        },
        "typedSubject": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "build-provenance"
            },
            "component": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\u0000]*$"
            },
            "sourceSHA": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "artifactSHA256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "kind",
            "component",
            "sourceSHA",
            "artifactSHA256"
          ]
        },
        "observedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$",
          "format": "date-time"
        },
        "validUntil": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$",
          "format": "date-time"
        }
      },
      "required": [
        "schemaVersion",
        "contractId",
        "typedSubject",
        "observedAt",
        "validUntil"
      ]
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "const": "build-attestor"
        },
        "keySPKISHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signatureHex": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        }
      },
      "required": [
        "role",
        "keySPKISHA256",
        "signatureHex"
      ]
    }
  },
  "required": [
    "body",
    "signer"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet5-k1-proposal.invalid/build-provenance.schema.json"
}
