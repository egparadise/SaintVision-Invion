{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "decisionConfirmationCount": {
            "const": 1
          },
          "decisionSignOff": {
            "const": false
          }
        }
      },
      "if": {
        "properties": {
          "outcome": {
            "const": "accepted"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "decisionConfirmationCount": {
            "const": 2
          },
          "decisionSignOff": {
            "const": true
          }
        }
      }
    }
  ],
  "description": "A final decision; only two-person ``accepted`` has decision sign-off.",
  "properties": {
    "acceptanceId": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Acceptanceid",
      "type": "string"
    },
    "acceptanceIdRef": {
      "pattern": "^[A-Z][A-Z0-9-]{1,15}$",
      "title": "Acceptanceidref",
      "type": "string"
    },
    "acceptedManifestSha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Acceptedmanifestsha256",
      "type": "string"
    },
    "decidedAt": {
      "format": "date-time",
      "title": "Decidedat",
      "type": "string"
    },
    "decisionConfirmationCount": {
      "maximum": 2,
      "minimum": 1,
      "title": "Decisionconfirmationcount",
      "type": "integer"
    },
    "decisionSignOff": {
      "title": "Decisionsignoff",
      "type": "boolean"
    },
    "manifestMatches": {
      "const": true,
      "title": "Manifestmatches",
      "type": "boolean"
    },
    "outcome": {
      "enum": [
        "accepted",
        "conditional",
        "rejected"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "releaseId": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Releaseid",
      "type": "string"
    },
    "replayed": {
      "title": "Replayed",
      "type": "boolean"
    },
    "state": {
      "const": "recorded",
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "acceptanceId",
    "releaseId",
    "acceptanceIdRef",
    "outcome",
    "state",
    "acceptedManifestSha256",
    "manifestMatches",
    "decisionSignOff",
    "decisionConfirmationCount",
    "decidedAt",
    "replayed"
  ],
  "title": "ReleaseAcceptanceRecordedResponse",
  "type": "object"
}
