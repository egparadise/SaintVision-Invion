{
  "$defs": {
    "ReleaseAcceptanceMeasurementRef": {
      "additionalProperties": false,
      "description": "One observed Evidence object, kept distinct from a target declaration.",
      "properties": {
        "evidenceId": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Evidenceid",
          "type": "string"
        },
        "evidenceSha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidencesha256",
          "type": "string"
        },
        "observedAt": {
          "format": "date-time",
          "title": "Observedat",
          "type": "string"
        }
      },
      "required": [
        "evidenceId",
        "evidenceSha256",
        "observedAt"
      ],
      "title": "ReleaseAcceptanceMeasurementRef",
      "type": "object"
    },
    "ReleaseAcceptanceTargetRef": {
      "additionalProperties": false,
      "description": "A desired acceptance target, not evidence that it was measured.",
      "properties": {
        "targetId": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:/-]{0,127}$",
          "title": "Targetid",
          "type": "string"
        },
        "targetSha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Targetsha256",
          "type": "string"
        }
      },
      "required": [
        "targetId",
        "targetSha256"
      ],
      "title": "ReleaseAcceptanceTargetRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The exact pending content a distinct confirmer must review before voting.",
  "properties": {
    "acceptanceIdRef": {
      "pattern": "^[A-Z][A-Z0-9-]{1,15}$",
      "title": "Acceptanceidref",
      "type": "string"
    },
    "countsTowardReleaseSignOff": {
      "const": false,
      "title": "Countstowardreleasesignoff",
      "type": "boolean"
    },
    "expiresAt": {
      "format": "date-time",
      "title": "Expiresat",
      "type": "string"
    },
    "knownLimitations": {
      "items": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 0,
      "title": "Knownlimitations",
      "type": "array"
    },
    "measurementRefs": {
      "items": {
        "$ref": "#/$defs/ReleaseAcceptanceMeasurementRef"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Measurementrefs",
      "type": "array"
    },
    "outcome": {
      "const": "accepted",
      "title": "Outcome",
      "type": "string"
    },
    "proposalConfirmationCount": {
      "const": 1,
      "title": "Proposalconfirmationcount",
      "type": "integer"
    },
    "proposalDigest": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Proposaldigest",
      "type": "string"
    },
    "proposalId": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Proposalid",
      "type": "string"
    },
    "reasonCode": {
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$",
      "title": "Reasoncode",
      "type": "string"
    },
    "releaseId": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Releaseid",
      "type": "string"
    },
    "requiredDistinctOperatorCount": {
      "const": 2,
      "title": "Requireddistinctoperatorcount",
      "type": "integer"
    },
    "state": {
      "const": "pending_second_operator",
      "title": "State",
      "type": "string"
    },
    "targetManifestSha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Targetmanifestsha256",
      "type": "string"
    },
    "targetRefs": {
      "items": {
        "$ref": "#/$defs/ReleaseAcceptanceTargetRef"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Targetrefs",
      "type": "array"
    }
  },
  "required": [
    "proposalId",
    "releaseId",
    "acceptanceIdRef",
    "outcome",
    "state",
    "targetManifestSha256",
    "proposalDigest",
    "reasonCode",
    "targetRefs",
    "measurementRefs",
    "knownLimitations",
    "requiredDistinctOperatorCount",
    "proposalConfirmationCount",
    "countsTowardReleaseSignOff",
    "expiresAt"
  ],
  "title": "ReleaseAcceptanceProposalReviewResponse",
  "type": "object"
}
