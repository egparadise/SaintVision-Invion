          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidateBudgetSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "contextGeneration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "contexts": {
          "type": "array",
