{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One-time enrollment credential returned after an operator admits a node.",
  "properties": {
    "announcementId": {
      "title": "Announcementid",
      "type": "string"
    },
    "bootstrapToken": {
      "maxLength": 256,
      "minLength": 16,
      "title": "Bootstraptoken",
      "type": "string"
    },
    "expiresAt": {
      "format": "date-time",
      "title": "Expiresat",
      "type": "string"
    },
    "next": {
      "title": "Next",
      "type": "string"
    }
  },
  "required": [
    "announcementId",
    "bootstrapToken",
    "expiresAt",
    "next"
  ],
  "title": "DiscoveryAdmissionResponse",
  "type": "object"
}
