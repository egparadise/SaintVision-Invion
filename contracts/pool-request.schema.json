{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "description": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "projectId": {
      "maxLength": 30,
      "title": "Projectid",
      "type": "string"
    }
  },
  "required": [
    "projectId",
    "name"
  ],
  "title": "PoolRequest",
  "type": "object"
}
