  "additionalProperties": false,
  "properties": {
    "memberCount": {
      "minimum": 0,
      "title": "Membercount",
      "type": "integer"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "poolId": {
      "title": "Poolid",
      "type": "string"
    },
    "projectId": {
      "title": "Projectid",
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "archived"
      ],
      "title": "Status",
      "type": "string"
    }
