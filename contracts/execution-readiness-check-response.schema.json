{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "check": {
      "title": "Check",
      "type": "string"
    },
    "detail": {
      "title": "Detail",
      "type": "string"
    },
    "maxContentBytes": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Maxcontentbytes"
    },
    "maxSnapshotBytes": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Maxsnapshotbytes"
    },
    "remedy": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Remedy"
    },
    "resolvedBy": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolvedby"
    },
    "runId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Runid"
    },
    "satisfied": {
      "title": "Satisfied",
      "type": "boolean"
    },
    "snapshotBytes": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Snapshotbytes"
    }
  },
  "required": [
    "check",
    "satisfied",
    "detail"
  ],
  "title": "ExecutionReadinessCheckResponse",
  "type": "object"
}
