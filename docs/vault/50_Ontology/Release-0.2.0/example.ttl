res:AC-01 a dev:AcceptanceCriterion ;
    sv:status "planned" ;
    dev:criterionText "계약과 owner 누락 0, 5노드 조사표의 미확인 값 명시" ;
    dev:requiresEvidence res:evidence-required-OUT-01 .

res:AC-02 a dev:AcceptanceCriterion ;
    sv:status "planned" ;
    dev:criterionText "허용 Node 등록·조회 성공, 토큰 재사용 차단, 다른 project 정보 접근 차단" ;
    dev:requiresEvidence res:evidence-required-OUT-02 .

res:AC-03 a dev:AcceptanceCriterion ;
    sv:status "planned" ;
    dev:criterionText "허용 실행 성공, 금지 경로/명령 차단, 종료 후 자원 회수" ;
    dev:requiresEvidence res:evidence-required-OUT-03 .

res:AC-04 a dev:AcceptanceCriterion ;
    sv:status "planned" ;
    dev:criterionText "승인 전 실행 0, 중복 요청 부수 효과 0, 전송 재개 hash 일치" ;
    dev:requiresEvidence res:evidence-required-OUT-04 .

res:AC-05 a dev:AcceptanceCriterion ;
    sv:status "planned" ;
    dev:criterionText "동일 입력 배치 동일, 50개 동시 예약 초과 0, P95 2초 목표 실측" ;
    dev:requiresEvidence res:evidence-required-OUT-05 .

res:AC-06 a dev:AcceptanceCriterion ;
    sv:status "planned" ;
    dev:criterionText "허용 범위 편집·Git 성공, CP 재시작 뒤 중복 실행 0, 복원 hash 일치" ;
    dev:requiresEvidence res:evidence-required-OUT-06 .

res:AC-07 a dev:AcceptanceCriterion ;
    sv:status "planned" ;
    dev:criterionText "이탈 감지 60초 이내, 오래된 토큰 쓰기 0, 복구 성공률 목표 95%" ;
    dev:requiresEvidence res:evidence-required-OUT-07 .

res:AC-08 a dev:AcceptanceCriterion ;
    sv:status "planned" ;
    dev:criterionText "Docker socket 미노출, 승인 우회 0, 합성 GPU 실행 성공, backup 복원" ;
    dev:requiresEvidence res:evidence-required-OUT-08 .

res:AC-09 a dev:AcceptanceCriterion ;
    sv:status "planned" ;
    dev:criterionText "Prompt 100건 유효율 99%, 코딩 과제 30건 성공률 70% 목표, 누출 0" ;
    dev:requiresEvidence res:evidence-required-OUT-09 .

res:AC-10 a dev:AcceptanceCriterion ;
    sv:status "planned" ;
    dev:criterionText "Codex/Claude 계약 동일, 모델의 데이터·코드·평가·승인 역추적" ;
    dev:requiresEvidence res:evidence-required-OUT-10 .

res:AC-11 a dev:AcceptanceCriterion ;
    sv:status "planned" ;
    dev:criterionText "주요 SLO와 실제값 보고, critical/high 미완화 0, rollback 검증" ;
    dev:requiresEvidence res:evidence-required-OUT-11 .

res:AC-12 a dev:AcceptanceCriterion ;
    sv:status "planned" ;
    dev:criterionText "5노드 전체 여정·정량 목표·알려진 제한·인수 확인 모두 기록" ;
