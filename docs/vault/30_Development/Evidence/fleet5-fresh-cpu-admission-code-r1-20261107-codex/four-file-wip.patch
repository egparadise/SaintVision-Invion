+
+    def connect(dsn, *, autocommit):
+        assert dsn == secret and autocommit is True
+        calls.append("db")
+        return db.connect()
+
+    monkeypatch.setenv("SV_FRESH_NODE_OPERATOR_DSN", secret)
+    monkeypatch.setattr(cli.psycopg, "connect", connect)
+    before = snapshot(db)
