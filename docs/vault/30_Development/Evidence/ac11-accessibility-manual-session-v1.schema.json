{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:saintvision:ac11-accessibility-manual-session:v1",
  "title": "AC-11 user-device accessibility manual session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runPurpose",
    "sourceHeadSha",
    "startedAt",
    "finishedAt",
    "device",
    "browser",
    "assistiveTechnologies",
    "scenarios",
    "overallResult",
    "performedBy"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "runPurpose": {"const": "s11-ac11-accessibility-user-device-manual"},
    "sourceHeadSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "startedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$"
    },
    "finishedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$"
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "operatingSystem", "displayMode", "keyboard"],
      "properties": {
        "class": {"enum": ["desktop", "laptop", "tablet", "mobile"]},
        "operatingSystem": {"type": "string", "minLength": 1, "maxLength": 100},
        "displayMode": {"enum": ["standard", "high-contrast", "zoomed"]},
        "keyboard": {"enum": ["physical", "on-screen", "switch-control"]}
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "engine"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "version": {"type": "string", "minLength": 1, "maxLength": 80},
        "engine": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    },
    "assistiveTechnologies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "product", "version"],
        "properties": {
          "kind": {"enum": ["screen-reader", "magnifier", "voice-control", "switch-control"]},
          "product": {"type": "string", "minLength": 1, "maxLength": 80},
          "version": {"type": "string", "minLength": 1, "maxLength": 80}
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenarioId", "result"],
        "properties": {
          "scenarioId": {
            "enum": [
              "ACC-MANUAL-KEYBOARD-JOURNEY",
              "ACC-MANUAL-SCREEN-READER-NAVIGATION",
              "ACC-MANUAL-SCREEN-READER-ERRORS",
              "ACC-MANUAL-FOCUS-ORDER",
              "ACC-MANUAL-ZOOM-REFLOW",
              "ACC-MANUAL-COGNITIVE-ERROR-RECOVERY"
            ]
          },
          "result": {"enum": ["PASS", "FAIL"]}
        }
      }
    },
    "overallResult": {"enum": ["PASS", "FAIL"]},
    "performedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "binding"],
      "properties": {
        "kind": {"const": "human"},
        "binding": {"const": "self-attested-session"}
      }
    }
  }
}
