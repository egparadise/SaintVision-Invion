{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "saintvision-plain-agent-migration:1 PROPOSED",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "saintvision-plain-agent-migration:1"
        },
        "migrationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000]*$"
        },
        "planEnvelopeSHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "workerRootRegistrationSHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/scope"
        },
        "daemonIdentitySHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ownerGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "commonFenceIdentitySHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "latestEvent": {
          "$ref": "common.schema.json#/$defs/eventRef"
        },
        "previousProjectionSHA256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "phase": {
          "enum": [
            "PROVENANCE_LOCKED",
            "RESERVED",
            "FENCE_INTENT",
            "OLD_FENCED",
            "CAPTURED",
            "PUBLICATION_INTENT",
            "OLD_PRESERVED",
            "NEW_CREATED",
            "NEW_START_INTENT",
            "NEW_STARTED_UNVERIFIED",
            "BOOTSTRAP_VERIFIED_RESTART_NO",
            "INVENTORY_PUBLISHED",
            "SEALED",
            "RESTART_POLICY_RESTORED",
            "READY_FOR_NEW_RENEWAL_PLAN",
            "BLOCKED_FORWARD_ONLY",
            "QUIESCENCE_UNKNOWN"
          ]
        },
        "ownerLeaseEnvelopeSHA256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "terminalSealEnvelopeSHA256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "oldBackup": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/container"
            },
            {
              "type": "null"
            }
          ]
        },
        "currentContainer": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/container"
            },
            {
              "type": "null"
            }
          ]
        },
        "volume": {
          "$ref": "common.schema.json#/$defs/volume"
        }
      },
      "required": [
        "schemaVersion",
        "migrationId",
        "planEnvelopeSHA256",
        "workerRootRegistrationSHA256",
        "scope",
        "daemonIdentitySHA256",
        "ownerGeneration",
        "commonFenceIdentitySHA256",
        "latestEvent",
        "previousProjectionSHA256",
        "phase",
        "ownerLeaseEnvelopeSHA256",
        "terminalSealEnvelopeSHA256",
        "oldBackup",
        "currentContainer",
        "volume"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "phase": {
                "enum": [
                  "SEALED",
                  "RESTART_POLICY_RESTORED",
                  "READY_FOR_NEW_RENEWAL_PLAN"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "terminalSealEnvelopeSHA256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "ownerLeaseEnvelopeSHA256": {
                "const": null
              },
              "oldBackup": {
                "$ref": "common.schema.json#/$defs/container"
              },
              "currentContainer": {
                "$ref": "common.schema.json#/$defs/container"
              }
            }
          },
          "else": {
            "properties": {
              "ownerLeaseEnvelopeSHA256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "terminalSealEnvelopeSHA256": {
                "const": null
              }
            }
          }
        }
      ]
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "const": "host-helper"
        },
        "keySPKISHA256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "signatureHex": {
          "$ref": "common.schema.json#/$defs/signature"
        }
      },
      "required": [
        "role",
        "keySPKISHA256",
        "signatureHex"
      ]
    }
  },
  "required": [
    "body",
    "signer"
  ]
}
