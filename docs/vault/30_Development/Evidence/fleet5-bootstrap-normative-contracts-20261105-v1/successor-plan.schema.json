{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "saintvision-plain-agent-migration-plan:1 PROPOSED",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "saintvision-plain-agent-migration-plan:1"
        },
        "planId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000]*$"
        },
        "migrationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000]*$"
        },
        "createdAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "expiresAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "canonicalContractSHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "acceptedP0": {
          "$ref": "common.schema.json#/$defs/product"
        },
        "image": {
          "$ref": "common.schema.json#/$defs/image"
        },
        "migrationHelper": {
          "$ref": "common.schema.json#/$defs/product"
        },
        "commonFence": {
          "$ref": "common.schema.json#/$defs/product"
        },
        "runtimeInventoryAPI": {
          "$ref": "common.schema.json#/$defs/product"
        },
        "schema3Helper": {
          "$ref": "common.schema.json#/$defs/product"
        },
        "newRenewalGuard": {
          "$ref": "common.schema.json#/$defs/product"
        },
        "nativeTwoCycleProof": {
          "$ref": "common.schema.json#/$defs/proof"
        },
        "oldNewNoWriteCompatibility": {
          "$ref": "common.schema.json#/$defs/proof"
        },
        "m2CapabilityProof": {
          "$ref": "common.schema.json#/$defs/proof"
        },
        "rootG2Decision": {
          "$ref": "common.schema.json#/$defs/proof"
        },
        "independentPlanReview": {
          "$ref": "common.schema.json#/$defs/proof"
        },
        "rootPublicationIntent": {
          "$ref": "common.schema.json#/$defs/proof"
        },
        "scheduleDisabledReadback": {
          "$ref": "common.schema.json#/$defs/proof"
        },
        "allLaunchSurfaces": {
          "$ref": "common.schema.json#/$defs/proof"
        },
        "noOverlap": {
          "$ref": "common.schema.json#/$defs/proof"
        },
        "legacyCPStateSHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "memberInputs": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/memberInput"
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": false
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "leafDeadline": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "caDeadline": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "policyDeadline": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "maintenanceStart": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "maintenanceEnd": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "normalRenewalStart": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "normalRenewalEnd": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "operatorWindowStart": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "operatorWindowEnd": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "measuredSafetyBudgetSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "maxEvidenceAgeSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 120
            },
            "maxClockSkewSeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 30
            }
          },
          "required": [
            "leafDeadline",
            "caDeadline",
            "policyDeadline",
            "maintenanceStart",
            "maintenanceEnd",
            "normalRenewalStart",
            "normalRenewalEnd",
            "operatorWindowStart",
            "operatorWindowEnd",
            "measuredSafetyBudgetSeconds",
            "maxEvidenceAgeSeconds",
            "maxClockSkewSeconds"
          ]
        },
        "restartRestore": {
          "enum": [
            "keep-no",
            "explicit-root-decision-later"
          ]
        },
        "secondMigrationAllowed": {
          "const": false
        },
        "credentialRecopyAllowed": {
          "const": false
        },
        "oldContainerRestartAllowed": {
          "const": false
        },
        "sourceOfFreshFiveIssuerAllowed": {
          "const": false
        },
        "expectedInventoryHead": {
          "$ref": "common.schema.json#/$defs/inventoryHead"
        },
        "planSubjectSHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "schemaVersion",
        "planId",
        "migrationId",
        "createdAt",
        "expiresAt",
        "canonicalContractSHA256",
        "acceptedP0",
        "image",
        "migrationHelper",
        "commonFence",
        "runtimeInventoryAPI",
        "schema3Helper",
        "newRenewalGuard",
        "nativeTwoCycleProof",
        "oldNewNoWriteCompatibility",
        "m2CapabilityProof",
        "rootG2Decision",
        "independentPlanReview",
        "rootPublicationIntent",
        "scheduleDisabledReadback",
        "allLaunchSurfaces",
        "noOverlap",
        "legacyCPStateSHA256",
        "memberInputs",
        "timing",
        "restartRestore",
        "secondMigrationAllowed",
        "credentialRecopyAllowed",
        "oldContainerRestartAllowed",
        "sourceOfFreshFiveIssuerAllowed",
        "expectedInventoryHead",
        "planSubjectSHA256"
      ]
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "const": "root-plan"
        },
        "keySPKISHA256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "signatureHex": {
          "$ref": "common.schema.json#/$defs/signature"
        }
      },
      "required": [
        "role",
        "keySPKISHA256",
        "signatureHex"
      ]
    }
  },
  "required": [
    "body",
    "signer"
  ]
}
