#!/bin/bash
set +e
go test -p=1 -count=1 -json -run '^TestH12(ScopedCryptoObjectBoundary|RepositoryResolvedExceptionPosition)$' ./internal/migrationcontext > /job/h12-phase2.stdout 2> /job/h12-phase2.stderr
rc=$?
cat /sys/fs/cgroup/memory.peak > /job/h12-phase2-memory-peak.bytes 2>/dev/null
printf "%s\n" "$rc" > /job/h12-phase2-exit.txt
exit "$rc"
