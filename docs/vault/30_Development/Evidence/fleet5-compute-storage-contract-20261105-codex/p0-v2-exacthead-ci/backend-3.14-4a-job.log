2026-11-05T14:59:15.3585357Z  2026-11-05 14:51:59.564 UTC [13912] CONTEXT:  PL/pgSQL function inline_code_block line 11 at RAISE
2026-11-05T14:59:15.3585600Z  2026-11-05 14:51:59.564 UTC [13912] STATEMENT:  
2026-11-05T14:59:15.3585753Z  	    DO $$ BEGIN
2026-11-05T14:59:15.3585930Z  	      CREATE ROLE inv_audit_writer NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE
2026-11-05T14:59:15.3586141Z  	        NOINHERIT NOBYPASSRLS;
2026-11-05T14:59:15.3586301Z  	    EXCEPTION WHEN duplicate_object THEN NULL;
2026-11-05T14:59:15.3586463Z  	    END $$;
2026-11-05T14:59:15.3586635Z  	    ALTER ROLE inv_audit_writer NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE
2026-11-05T14:59:15.3586842Z  	      NOINHERIT NOBYPASSRLS;
2026-11-05T14:59:15.3587073Z  	    -- A member of the owning role can act as the definer, which would turn the
2026-11-05T14:59:15.3587344Z  	    -- narrow primitive into a general append path (the 0045 guard, same reason).
2026-11-05T14:59:15.3587553Z  	    DO $$ BEGIN
2026-11-05T14:59:15.3587665Z  	      IF EXISTS (
2026-11-05T14:59:15.3587791Z  	        SELECT 1 FROM pg_auth_members m
2026-11-05T14:59:15.3587979Z  	        JOIN pg_roles granted_role ON granted_role.oid = m.roleid
2026-11-05T14:59:15.3588185Z  	        WHERE granted_role.rolname = 'inv_audit_writer'
2026-11-05T14:59:15.3588348Z  	      ) THEN
2026-11-05T14:59:15.3588546Z  	        RAISE EXCEPTION 'inv_audit_writer has members; refusing denial-primitive ownership';
2026-11-05T14:59:15.3588772Z  	      END IF;
2026-11-05T14:59:15.3588882Z  	    END $$;
2026-11-05T14:59:15.3588992Z  	    DO $$ BEGIN
2026-11-05T14:59:15.3589165Z  	      CREATE ROLE inv_audit_reader NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE
2026-11-05T14:59:15.3589372Z  	        NOINHERIT NOBYPASSRLS;
2026-11-05T14:59:15.3589524Z  	    EXCEPTION WHEN duplicate_object THEN NULL;
2026-11-05T14:59:15.3589677Z  	    END $$;
2026-11-05T14:59:15.3589844Z  	    ALTER ROLE inv_audit_reader NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE
2026-11-05T14:59:15.3590047Z  	      NOINHERIT NOBYPASSRLS;
2026-11-05T14:59:15.3590246Z  	    -- Any pre-existing member at all stops the migration, not just inv_app and
2026-11-05T14:59:15.3590507Z  	    -- inv_kernel. Naming those two would only catch a direct grant: with
2026-11-05T14:59:15.3590761Z  	    -- `GRANT inv_audit_reader TO audit_bridge; GRANT audit_bridge TO inv_app` the
2026-11-05T14:59:15.3591040Z  	    -- runtime role assumes the reader transitively and the check would pass. It
2026-11-05T14:59:15.3591400Z  	    -- would also let an unrelated pre-existing login become a cross-tenant audit
2026-11-05T14:59:15.3591672Z  	    -- reader with no review. Every membership chain that reaches this role has a
2026-11-05T14:59:15.3591930Z  	    -- direct member at its head, so refusing direct members refuses the chains
2026-11-05T14:59:15.3592310Z  	    -- too -- which is why there is one guard here and not two.
2026-11-05T14:59:15.3592490Z  	    DO $$
2026-11-05T14:59:15.3592605Z  	    DECLARE members text;
2026-11-05T14:59:15.3592731Z  	    BEGIN
2026-11-05T14:59:15.3592901Z  	      SELECT string_agg(member_role.rolname, ', ' ORDER BY member_role.rolname)
2026-11-05T14:59:15.3593103Z  	        INTO members
2026-11-05T14:59:15.3593230Z  	        FROM pg_auth_members m
2026-11-05T14:59:15.3593406Z  	        JOIN pg_roles granted_role ON granted_role.oid = m.roleid
2026-11-05T14:59:15.3593619Z  	        JOIN pg_roles member_role ON member_role.oid = m.member
2026-11-05T14:59:15.3593902Z  	       WHERE granted_role.rolname = 'inv_audit_reader';
2026-11-05T14:59:15.3594074Z  	      IF members IS NOT NULL THEN
2026-11-05T14:59:15.3594217Z  	        RAISE EXCEPTION
2026-11-05T14:59:15.3594431Z  	          'inv_audit_reader already has members (%); review membership before migration', members;
2026-11-05T14:59:15.3594659Z  	      END IF;
2026-11-05T14:59:15.3594763Z  	    END $$;
2026-11-05T14:59:15.3594901Z  	    GRANT USAGE ON SCHEMA public TO inv_audit_reader;
2026-11-05T14:59:15.3595125Z  	    -- CREATE is needed only to receive ownership of the function below, and is
2026-11-05T14:59:15.3595342Z  	    -- revoked again in the same transaction.
2026-11-05T14:59:15.3595534Z  	    GRANT USAGE, CREATE ON SCHEMA public TO inv_audit_writer;
2026-11-05T14:59:15.3595712Z  	
2026-11-05T14:59:15.3595843Z  	    ALTER TABLE audit_events ENABLE ROW LEVEL SECURITY;
2026-11-05T14:59:15.3596065Z  	    -- FORCE, or the migration owner silently bypasses every policy below.
2026-11-05T14:59:15.3596293Z  	    ALTER TABLE audit_events FORCE ROW LEVEL SECURITY;
2026-11-05T14:59:15.3596529Z  	    CREATE POLICY audit_events_tenant_isolation ON audit_events FOR ALL TO inv_app
2026-11-05T14:59:15.3596803Z  	      USING (tenant_id = nullif(current_setting('inv.tenant_id',true),'')::uuid)
2026-11-05T14:59:15.3597075Z  	      WITH CHECK (tenant_id = nullif(current_setting('inv.tenant_id',true),'')::uuid);
2026-11-05T14:59:15.3597369Z  	    CREATE POLICY audit_events_denial_append ON audit_events FOR INSERT TO inv_audit_writer
2026-11-05T14:59:15.3597628Z  	      WITH CHECK (tenant_id IS NULL AND outcome = 'deny');
2026-11-05T14:59:15.3597875Z  	    CREATE POLICY audit_events_audit_read ON audit_events FOR SELECT TO inv_audit_reader
2026-11-05T14:59:15.3598095Z  	      USING (true);
2026-11-05T14:59:15.3598279Z  	    -- The application never reads audit records; it only appends them. INSERT
2026-11-05T14:59:15.3598531Z  	    -- stays, so append-only for this role is unchanged (PLAN-DB-001).
2026-11-05T14:59:15.3598742Z  	    REVOKE SELECT ON audit_events FROM inv_app;
2026-11-05T14:59:15.3598925Z  	    GRANT INSERT ON audit_events TO inv_audit_writer;
2026-11-05T14:59:15.3599111Z  	    GRANT SELECT ON audit_events TO inv_audit_reader;
2026-11-05T14:59:15.3599266Z  	
2026-11-05T14:59:15.3599435Z  	    -- The only way the application can record a denial it cannot attribute to a
2026-11-05T14:59:15.3599698Z  	    -- tenant. tenant_id, outcome and occurred_at are constants here: the caller
2026-11-05T14:59:15.3599958Z  	    -- chooses the facts of the denial, never whose row it is, whether it was an
2026-11-05T14:59:15.3600166Z  	    -- allow, or when it happened.
2026-11-05T14:59:15.3600328Z  	    CREATE FUNCTION public.record_auth_denial(
2026-11-05T14:59:15.3600487Z  	      p_event_id text,
2026-11-05T14:59:15.3600625Z  	      p_actor_type text,
2026-11-05T14:59:15.3600752Z  	      p_action text,
2026-11-05T14:59:15.3600877Z  	      p_reason_code text,
2026-11-05T14:59:15.3601009Z  	      p_actor_id text,
2026-11-05T14:59:15.3601135Z  	      p_trace_id text,
2026-11-05T14:59:15.3601356Z  	      p_target_type text,
2026-11-05T14:59:15.3601487Z  	      p_target_id text,
2026-11-05T14:59:15.3601616Z  	      p_detail jsonb,
2026-11-05T14:59:15.3601740Z  	      p_source_ip text,
2026-11-05T14:59:15.3601866Z  	      p_user_agent text
2026-11-05T14:59:15.3601990Z  	    ) RETURNS void
2026-11-05T14:59:15.3602248Z  	    LANGUAGE plpgsql
2026-11-05T14:59:15.3602375Z  	    SECURITY DEFINER
2026-11-05T14:59:15.3602560Z  	    -- Pinned, because a SECURITY DEFINER function that resolves names through
2026-11-05T14:59:15.3602820Z  	    -- the caller's search_path becomes a privilege escalation. Everything the
2026-11-05T14:59:15.3603077Z  	    -- body touches is schema-qualified, so pg_catalog alone is enough.
2026-11-05T14:59:15.3603280Z  	    SET search_path = pg_catalog
2026-11-05T14:59:15.3603416Z  	    AS $fn$
2026-11-05T14:59:15.3603522Z  	    BEGIN
2026-11-05T14:59:15.3603684Z  	      IF p_event_id IS NULL OR p_actor_type IS NULL OR p_action IS NULL
2026-11-05T14:59:15.3603966Z  	         OR p_reason_code IS NULL THEN
2026-11-05T14:59:15.3604204Z  	        RAISE EXCEPTION 'a denial record needs an event id, actor type, action and reason code'
2026-11-05T14:59:15.3604440Z  	          USING ERRCODE = '22023';
2026-11-05T14:59:15.3604576Z  	      END IF;
2026-11-05T14:59:15.3604698Z  	      INSERT INTO public.audit_events
2026-11-05T14:59:15.3604906Z  	        (event_id, occurred_at, tenant_id, actor_type, actor_id, action, outcome,
2026-11-05T14:59:15.3605172Z  	         reason_code, trace_id, target_type, target_id, detail, source_ip, user_agent)
2026-11-05T14:59:15.3605378Z  	      VALUES
2026-11-05T14:59:15.3605547Z  	        (p_event_id, clock_timestamp(), NULL, p_actor_type, p_actor_id, p_action,
2026-11-05T14:59:15.3605789Z  	         'deny', p_reason_code, p_trace_id, p_target_type, p_target_id,
2026-11-05T14:59:15.3606013Z  	         coalesce(p_detail, '{}'::jsonb), p_source_ip, p_user_agent);
2026-11-05T14:59:15.3606195Z  	    END
2026-11-05T14:59:15.3606301Z  	    $fn$;
2026-11-05T14:59:15.3606422Z  	    GRANT inv_audit_writer TO CURRENT_USER;
2026-11-05T14:59:15.3606696Z  	    ALTER FUNCTION public.record_auth_denial(text,text,text,text,text,text,text,text,jsonb,text,text)
2026-11-05T14:59:15.3606957Z  	      OWNER TO inv_audit_writer;
2026-11-05T14:59:15.3607127Z  	    REVOKE CREATE ON SCHEMA public FROM inv_audit_writer;
2026-11-05T14:59:15.3607319Z  	    REVOKE inv_audit_writer FROM CURRENT_USER;
2026-11-05T14:59:15.3607599Z  	    REVOKE ALL ON FUNCTION public.record_auth_denial(text,text,text,text,text,text,text,text,jsonb,text,text)
2026-11-05T14:59:15.3607869Z  	      FROM PUBLIC;
