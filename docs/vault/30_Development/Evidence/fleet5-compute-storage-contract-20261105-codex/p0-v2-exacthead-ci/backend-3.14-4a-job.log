2026-11-05T14:59:15.3609927Z  2026-11-05 14:52:01.695 UTC [13919] ERROR:  inv_audit_reader already has members (inv_audit_bridge_7d4497ec59a8); review membership before migration
2026-11-05T14:59:15.3610314Z  2026-11-05 14:52:01.695 UTC [13919] CONTEXT:  PL/pgSQL function inline_code_block line 11 at RAISE
2026-11-05T14:59:15.3610563Z  2026-11-05 14:52:01.695 UTC [13919] STATEMENT:  
2026-11-05T14:59:15.3610715Z  	    DO $$ BEGIN
2026-11-05T14:59:15.3610888Z  	      CREATE ROLE inv_audit_writer NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE
2026-11-05T14:59:15.3611098Z  	        NOINHERIT NOBYPASSRLS;
2026-11-05T14:59:15.3611254Z  	    EXCEPTION WHEN duplicate_object THEN NULL;
2026-11-05T14:59:15.3611407Z  	    END $$;
2026-11-05T14:59:15.3611669Z  	    ALTER ROLE inv_audit_writer NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE
2026-11-05T14:59:15.3611875Z  	      NOINHERIT NOBYPASSRLS;
2026-11-05T14:59:15.3612170Z  	    -- A member of the owning role can act as the definer, which would turn the
2026-11-05T14:59:15.3612463Z  	    -- narrow primitive into a general append path (the 0045 guard, same reason).
2026-11-05T14:59:15.3612670Z  	    DO $$ BEGIN
2026-11-05T14:59:15.3612781Z  	      IF EXISTS (
2026-11-05T14:59:15.3612911Z  	        SELECT 1 FROM pg_auth_members m
2026-11-05T14:59:15.3613095Z  	        JOIN pg_roles granted_role ON granted_role.oid = m.roleid
2026-11-05T14:59:15.3613301Z  	        WHERE granted_role.rolname = 'inv_audit_writer'
2026-11-05T14:59:15.3613458Z  	      ) THEN
2026-11-05T14:59:15.3613654Z  	        RAISE EXCEPTION 'inv_audit_writer has members; refusing denial-primitive ownership';
2026-11-05T14:59:15.3613874Z  	      END IF;
2026-11-05T14:59:15.3614070Z  	    END $$;
2026-11-05T14:59:15.3614175Z  	    DO $$ BEGIN
2026-11-05T14:59:15.3614347Z  	      CREATE ROLE inv_audit_reader NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE
2026-11-05T14:59:15.3614553Z  	        NOINHERIT NOBYPASSRLS;
2026-11-05T14:59:15.3614706Z  	    EXCEPTION WHEN duplicate_object THEN NULL;
2026-11-05T14:59:15.3614856Z  	    END $$;
2026-11-05T14:59:15.3615027Z  	    ALTER ROLE inv_audit_reader NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE
2026-11-05T14:59:15.3615234Z  	      NOINHERIT NOBYPASSRLS;
2026-11-05T14:59:15.3615431Z  	    -- Any pre-existing member at all stops the migration, not just inv_app and
2026-11-05T14:59:15.3615687Z  	    -- inv_kernel. Naming those two would only catch a direct grant: with
2026-11-05T14:59:15.3615943Z  	    -- `GRANT inv_audit_reader TO audit_bridge; GRANT audit_bridge TO inv_app` the
2026-11-05T14:59:15.3616215Z  	    -- runtime role assumes the reader transitively and the check would pass. It
2026-11-05T14:59:15.3616485Z  	    -- would also let an unrelated pre-existing login become a cross-tenant audit
2026-11-05T14:59:15.3616754Z  	    -- reader with no review. Every membership chain that reaches this role has a
2026-11-05T14:59:15.3617011Z  	    -- direct member at its head, so refusing direct members refuses the chains
2026-11-05T14:59:15.3617243Z  	    -- too -- which is why there is one guard here and not two.
2026-11-05T14:59:15.3617417Z  	    DO $$
2026-11-05T14:59:15.3617534Z  	    DECLARE members text;
2026-11-05T14:59:15.3617660Z  	    BEGIN
2026-11-05T14:59:15.3617826Z  	      SELECT string_agg(member_role.rolname, ', ' ORDER BY member_role.rolname)
2026-11-05T14:59:15.3618028Z  	        INTO members
2026-11-05T14:59:15.3618155Z  	        FROM pg_auth_members m
2026-11-05T14:59:15.3618327Z  	        JOIN pg_roles granted_role ON granted_role.oid = m.roleid
2026-11-05T14:59:15.3618540Z  	        JOIN pg_roles member_role ON member_role.oid = m.member
2026-11-05T14:59:15.3618739Z  	       WHERE granted_role.rolname = 'inv_audit_reader';
2026-11-05T14:59:15.3618910Z  	      IF members IS NOT NULL THEN
2026-11-05T14:59:15.3619054Z  	        RAISE EXCEPTION
2026-11-05T14:59:15.3619263Z  	          'inv_audit_reader already has members (%); review membership before migration', members;
2026-11-05T14:59:15.3619486Z  	      END IF;
2026-11-05T14:59:15.3619597Z  	    END $$;
2026-11-05T14:59:15.3619732Z  	    GRANT USAGE ON SCHEMA public TO inv_audit_reader;
2026-11-05T14:59:15.3619953Z  	    -- CREATE is needed only to receive ownership of the function below, and is
2026-11-05T14:59:15.3620172Z  	    -- revoked again in the same transaction.
2026-11-05T14:59:15.3620366Z  	    GRANT USAGE, CREATE ON SCHEMA public TO inv_audit_writer;
2026-11-05T14:59:15.3620537Z  	
2026-11-05T14:59:15.3620667Z  	    ALTER TABLE audit_events ENABLE ROW LEVEL SECURITY;
2026-11-05T14:59:15.3620892Z  	    -- FORCE, or the migration owner silently bypasses every policy below.
2026-11-05T14:59:15.3621115Z  	    ALTER TABLE audit_events FORCE ROW LEVEL SECURITY;
2026-11-05T14:59:15.3621443Z  	    CREATE POLICY audit_events_tenant_isolation ON audit_events FOR ALL TO inv_app
2026-11-05T14:59:15.3621717Z  	      USING (tenant_id = nullif(current_setting('inv.tenant_id',true),'')::uuid)
2026-11-05T14:59:15.3621982Z  	      WITH CHECK (tenant_id = nullif(current_setting('inv.tenant_id',true),'')::uuid);
2026-11-05T14:59:15.3622421Z  	    CREATE POLICY audit_events_denial_append ON audit_events FOR INSERT TO inv_audit_writer
2026-11-05T14:59:15.3622676Z  	      WITH CHECK (tenant_id IS NULL AND outcome = 'deny');
2026-11-05T14:59:15.3622924Z  	    CREATE POLICY audit_events_audit_read ON audit_events FOR SELECT TO inv_audit_reader
2026-11-05T14:59:15.3623141Z  	      USING (true);
2026-11-05T14:59:15.3623322Z  	    -- The application never reads audit records; it only appends them. INSERT
2026-11-05T14:59:15.3623575Z  	    -- stays, so append-only for this role is unchanged (PLAN-DB-001).
2026-11-05T14:59:15.3623782Z  	    REVOKE SELECT ON audit_events FROM inv_app;
2026-11-05T14:59:15.3624044Z  	    GRANT INSERT ON audit_events TO inv_audit_writer;
2026-11-05T14:59:15.3624230Z  	    GRANT SELECT ON audit_events TO inv_audit_reader;
2026-11-05T14:59:15.3624385Z  	
2026-11-05T14:59:15.3624547Z  	    -- The only way the application can record a denial it cannot attribute to a
2026-11-05T14:59:15.3624814Z  	    -- tenant. tenant_id, outcome and occurred_at are constants here: the caller
2026-11-05T14:59:15.3625077Z  	    -- chooses the facts of the denial, never whose row it is, whether it was an
2026-11-05T14:59:15.3625283Z  	    -- allow, or when it happened.
2026-11-05T14:59:15.3625442Z  	    CREATE FUNCTION public.record_auth_denial(
2026-11-05T14:59:15.3625600Z  	      p_event_id text,
2026-11-05T14:59:15.3625726Z  	      p_actor_type text,
2026-11-05T14:59:15.3625859Z  	      p_action text,
2026-11-05T14:59:15.3625982Z  	      p_reason_code text,
2026-11-05T14:59:15.3626110Z  	      p_actor_id text,
2026-11-05T14:59:15.3626234Z  	      p_trace_id text,
2026-11-05T14:59:15.3626362Z  	      p_target_type text,
2026-11-05T14:59:15.3626492Z  	      p_target_id text,
2026-11-05T14:59:15.3626619Z  	      p_detail jsonb,
2026-11-05T14:59:15.3626746Z  	      p_source_ip text,
2026-11-05T14:59:15.3626873Z  	      p_user_agent text
2026-11-05T14:59:15.3626995Z  	    ) RETURNS void
2026-11-05T14:59:15.3627119Z  	    LANGUAGE plpgsql
2026-11-05T14:59:15.3627238Z  	    SECURITY DEFINER
2026-11-05T14:59:15.3627418Z  	    -- Pinned, because a SECURITY DEFINER function that resolves names through
2026-11-05T14:59:15.3627683Z  	    -- the caller's search_path becomes a privilege escalation. Everything the
2026-11-05T14:59:15.3627936Z  	    -- body touches is schema-qualified, so pg_catalog alone is enough.
2026-11-05T14:59:15.3628137Z  	    SET search_path = pg_catalog
2026-11-05T14:59:15.3628275Z  	    AS $fn$
2026-11-05T14:59:15.3628380Z  	    BEGIN
2026-11-05T14:59:15.3628529Z  	      IF p_event_id IS NULL OR p_actor_type IS NULL OR p_action IS NULL
2026-11-05T14:59:15.3628729Z  	         OR p_reason_code IS NULL THEN
2026-11-05T14:59:15.3628966Z  	        RAISE EXCEPTION 'a denial record needs an event id, actor type, action and reason code'
2026-11-05T14:59:15.3629200Z  	          USING ERRCODE = '22023';
2026-11-05T14:59:15.3629339Z  	      END IF;
2026-11-05T14:59:15.3629461Z  	      INSERT INTO public.audit_events
2026-11-05T14:59:15.3629665Z  	        (event_id, occurred_at, tenant_id, actor_type, actor_id, action, outcome,
2026-11-05T14:59:15.3629935Z  	         reason_code, trace_id, target_type, target_id, detail, source_ip, user_agent)
2026-11-05T14:59:15.3630139Z  	      VALUES
2026-11-05T14:59:15.3630306Z  	        (p_event_id, clock_timestamp(), NULL, p_actor_type, p_actor_id, p_action,
2026-11-05T14:59:15.3630545Z  	         'deny', p_reason_code, p_trace_id, p_target_type, p_target_id,
2026-11-05T14:59:15.3630770Z  	         coalesce(p_detail, '{}'::jsonb), p_source_ip, p_user_agent);
2026-11-05T14:59:15.3630948Z  	    END
2026-11-05T14:59:15.3631053Z  	    $fn$;
2026-11-05T14:59:15.3631176Z  	    GRANT inv_audit_writer TO CURRENT_USER;
2026-11-05T14:59:15.3631538Z  	    ALTER FUNCTION public.record_auth_denial(text,text,text,text,text,text,text,text,jsonb,text,text)
2026-11-05T14:59:15.3631801Z  	      OWNER TO inv_audit_writer;
2026-11-05T14:59:15.3631970Z  	    REVOKE CREATE ON SCHEMA public FROM inv_audit_writer;
2026-11-05T14:59:15.3632298Z  	    REVOKE inv_audit_writer FROM CURRENT_USER;
2026-11-05T14:59:15.3632580Z  	    REVOKE ALL ON FUNCTION public.record_auth_denial(text,text,text,text,text,text,text,text,jsonb,text,text)
2026-11-05T14:59:15.3632849Z  	      FROM PUBLIC;
2026-11-05T14:59:15.3644723Z  	    GRANT EXECUTE ON FUNCTION public.record_auth_denial(text,text,text,text,text,text,text,text,jsonb,text,text)
2026-11-05T14:59:15.3645008Z  	      TO inv_app;
