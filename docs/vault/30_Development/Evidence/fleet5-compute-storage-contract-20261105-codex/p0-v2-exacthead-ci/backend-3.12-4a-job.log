2026-11-05T15:07:23.3842241Z  	    END $$;
2026-11-05T15:07:23.3842483Z  	    ALTER ROLE inv_audit_reader NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE
2026-11-05T15:07:23.3842779Z  	      NOINHERIT NOBYPASSRLS;
2026-11-05T15:07:23.3843079Z  	    -- Any pre-existing member at all stops the migration, not just inv_app and
2026-11-05T15:07:23.3843451Z  	    -- inv_kernel. Naming those two would only catch a direct grant: with
2026-11-05T15:07:23.3843822Z  	    -- `GRANT inv_audit_reader TO audit_bridge; GRANT audit_bridge TO inv_app` the
2026-11-05T15:07:23.3844232Z  	    -- runtime role assumes the reader transitively and the check would pass. It
2026-11-05T15:07:23.3844626Z  	    -- would also let an unrelated pre-existing login become a cross-tenant audit
2026-11-05T15:07:23.3845005Z  	    -- reader with no review. Every membership chain that reaches this role has a
2026-11-05T15:07:23.3845377Z  	    -- direct member at its head, so refusing direct members refuses the chains
2026-11-05T15:07:23.3845710Z  	    -- too -- which is why there is one guard here and not two.
2026-11-05T15:07:23.3845960Z  	    DO $$
2026-11-05T15:07:23.3846137Z  	    DECLARE members text;
2026-11-05T15:07:23.3846320Z  	    BEGIN
2026-11-05T15:07:23.3846556Z  	      SELECT string_agg(member_role.rolname, ', ' ORDER BY member_role.rolname)
2026-11-05T15:07:23.3846845Z  	        INTO members
2026-11-05T15:07:23.3847036Z  	        FROM pg_auth_members m
2026-11-05T15:07:23.3847284Z  	        JOIN pg_roles granted_role ON granted_role.oid = m.roleid
2026-11-05T15:07:23.3847586Z  	        JOIN pg_roles member_role ON member_role.oid = m.member
2026-11-05T15:07:23.3847877Z  	       WHERE granted_role.rolname = 'inv_audit_reader';
2026-11-05T15:07:23.3848123Z  	      IF members IS NOT NULL THEN
2026-11-05T15:07:23.3848472Z  	        RAISE EXCEPTION
2026-11-05T15:07:23.3848790Z  	          'inv_audit_reader already has members (%); review membership before migration', members;
2026-11-05T15:07:23.3849121Z  	      END IF;
2026-11-05T15:07:23.3849280Z  	    END $$;
2026-11-05T15:07:23.3849481Z  	    GRANT USAGE ON SCHEMA public TO inv_audit_reader;
2026-11-05T15:07:23.3849815Z  	    -- CREATE is needed only to receive ownership of the function below, and is
2026-11-05T15:07:23.3850124Z  	    -- revoked again in the same transaction.
2026-11-05T15:07:23.3850397Z  	    GRANT USAGE, CREATE ON SCHEMA public TO inv_audit_writer;
2026-11-05T15:07:23.3850655Z  	
2026-11-05T15:07:23.3850845Z  	    ALTER TABLE audit_events ENABLE ROW LEVEL SECURITY;
2026-11-05T15:07:23.3851156Z  	    -- FORCE, or the migration owner silently bypasses every policy below.
2026-11-05T15:07:23.3851482Z  	    ALTER TABLE audit_events FORCE ROW LEVEL SECURITY;
2026-11-05T15:07:23.3851825Z  	    CREATE POLICY audit_events_tenant_isolation ON audit_events FOR ALL TO inv_app
2026-11-05T15:07:23.3852220Z  	      USING (tenant_id = nullif(current_setting('inv.tenant_id',true),'')::uuid)
2026-11-05T15:07:23.3852605Z  	      WITH CHECK (tenant_id = nullif(current_setting('inv.tenant_id',true),'')::uuid);
2026-11-05T15:07:23.3853141Z  	    CREATE POLICY audit_events_denial_append ON audit_events FOR INSERT TO inv_audit_writer
2026-11-05T15:07:23.3853514Z  	      WITH CHECK (tenant_id IS NULL AND outcome = 'deny');
2026-11-05T15:07:23.3853871Z  	    CREATE POLICY audit_events_audit_read ON audit_events FOR SELECT TO inv_audit_reader
2026-11-05T15:07:23.3854188Z  	      USING (true);
2026-11-05T15:07:23.3854450Z  	    -- The application never reads audit records; it only appends them. INSERT
2026-11-05T15:07:23.3854928Z  	    -- stays, so append-only for this role is unchanged (PLAN-DB-001).
2026-11-05T15:07:23.3855229Z  	    REVOKE SELECT ON audit_events FROM inv_app;
2026-11-05T15:07:23.3855488Z  	    GRANT INSERT ON audit_events TO inv_audit_writer;
2026-11-05T15:07:23.3855758Z  	    GRANT SELECT ON audit_events TO inv_audit_reader;
2026-11-05T15:07:23.3855983Z  	
2026-11-05T15:07:23.3856220Z  	    -- The only way the application can record a denial it cannot attribute to a
2026-11-05T15:07:23.3856595Z  	    -- tenant. tenant_id, outcome and occurred_at are constants here: the caller
2026-11-05T15:07:23.3856974Z  	    -- chooses the facts of the denial, never whose row it is, whether it was an
2026-11-05T15:07:23.3857266Z  	    -- allow, or when it happened.
2026-11-05T15:07:23.3857498Z  	    CREATE FUNCTION public.record_auth_denial(
2026-11-05T15:07:23.3857736Z  	      p_event_id text,
2026-11-05T15:07:23.3857924Z  	      p_actor_type text,
2026-11-05T15:07:23.3858113Z  	      p_action text,
2026-11-05T15:07:23.3858439Z  	      p_reason_code text,
2026-11-05T15:07:23.3858654Z  	      p_actor_id text,
2026-11-05T15:07:23.3858832Z  	      p_trace_id text,
2026-11-05T15:07:23.3859011Z  	      p_target_type text,
2026-11-05T15:07:23.3859199Z  	      p_target_id text,
2026-11-05T15:07:23.3859391Z  	      p_detail jsonb,
2026-11-05T15:07:23.3859568Z  	      p_source_ip text,
2026-11-05T15:07:23.3859761Z  	      p_user_agent text
2026-11-05T15:07:23.3859931Z  	    ) RETURNS void
2026-11-05T15:07:23.3860102Z  	    LANGUAGE plpgsql
2026-11-05T15:07:23.3860284Z  	    SECURITY DEFINER
2026-11-05T15:07:23.3860539Z  	    -- Pinned, because a SECURITY DEFINER function that resolves names through
2026-11-05T15:07:23.3860910Z  	    -- the caller's search_path becomes a privilege escalation. Everything the
2026-11-05T15:07:23.3861272Z  	    -- body touches is schema-qualified, so pg_catalog alone is enough.
2026-11-05T15:07:23.3861566Z  	    SET search_path = pg_catalog
2026-11-05T15:07:23.3861765Z  	    AS $fn$
2026-11-05T15:07:23.3861920Z  	    BEGIN
2026-11-05T15:07:23.3862143Z  	      IF p_event_id IS NULL OR p_actor_type IS NULL OR p_action IS NULL
2026-11-05T15:07:23.3862418Z  	         OR p_reason_code IS NULL THEN
2026-11-05T15:07:23.3862754Z  	        RAISE EXCEPTION 'a denial record needs an event id, actor type, action and reason code'
2026-11-05T15:07:23.3863092Z  	          USING ERRCODE = '22023';
2026-11-05T15:07:23.3863285Z  	      END IF;
2026-11-05T15:07:23.3863462Z  	      INSERT INTO public.audit_events
2026-11-05T15:07:23.3863759Z  	        (event_id, occurred_at, tenant_id, actor_type, actor_id, action, outcome,
2026-11-05T15:07:23.3864144Z  	         reason_code, trace_id, target_type, target_id, detail, source_ip, user_agent)
2026-11-05T15:07:23.3864438Z  	      VALUES
2026-11-05T15:07:23.3864677Z  	        (p_event_id, clock_timestamp(), NULL, p_actor_type, p_actor_id, p_action,
2026-11-05T15:07:23.3865023Z  	         'deny', p_reason_code, p_trace_id, p_target_type, p_target_id,
2026-11-05T15:07:23.3865343Z  	         coalesce(p_detail, '{}'::jsonb), p_source_ip, p_user_agent);
2026-11-05T15:07:23.3865601Z  	    END
2026-11-05T15:07:23.3865760Z  	    $fn$;
2026-11-05T15:07:23.3865937Z  	    GRANT inv_audit_writer TO CURRENT_USER;
2026-11-05T15:07:23.3866324Z  	    ALTER FUNCTION public.record_auth_denial(text,text,text,text,text,text,text,text,jsonb,text,text)
2026-11-05T15:07:23.3866709Z  	      OWNER TO inv_audit_writer;
2026-11-05T15:07:23.3866952Z  	    REVOKE CREATE ON SCHEMA public FROM inv_audit_writer;
2026-11-05T15:07:23.3867227Z  	    REVOKE inv_audit_writer FROM CURRENT_USER;
2026-11-05T15:07:23.3867788Z  	    REVOKE ALL ON FUNCTION public.record_auth_denial(text,text,text,text,text,text,text,text,jsonb,text,text)
2026-11-05T15:07:23.3868179Z  	      FROM PUBLIC;
2026-11-05T15:07:23.3868644Z  	    GRANT EXECUTE ON FUNCTION public.record_auth_denial(text,text,text,text,text,text,text,text,jsonb,text,text)
2026-11-05T15:07:23.3869035Z  	      TO inv_app;
2026-11-05T15:07:23.3869197Z  	    
