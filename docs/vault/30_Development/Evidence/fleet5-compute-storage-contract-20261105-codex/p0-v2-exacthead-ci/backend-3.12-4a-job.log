2026-11-05T15:07:23.3799541Z  2026-11-05 14:56:10.916 UTC [14346] ERROR:  inv_audit_reader already has members (inv_audit_leaf_7f0cd2d73484); review membership before migration
2026-11-05T15:07:23.3800081Z  2026-11-05 14:56:10.916 UTC [14346] CONTEXT:  PL/pgSQL function inline_code_block line 11 at RAISE
2026-11-05T15:07:23.3800434Z  2026-11-05 14:56:10.916 UTC [14346] STATEMENT:  
2026-11-05T15:07:23.3800653Z  	    DO $$ BEGIN
2026-11-05T15:07:23.3800903Z  	      CREATE ROLE inv_audit_writer NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE
2026-11-05T15:07:23.3801205Z  	        NOINHERIT NOBYPASSRLS;
2026-11-05T15:07:23.3801426Z  	    EXCEPTION WHEN duplicate_object THEN NULL;
2026-11-05T15:07:23.3801641Z  	    END $$;
2026-11-05T15:07:23.3801882Z  	    ALTER ROLE inv_audit_writer NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE
2026-11-05T15:07:23.3802177Z  	      NOINHERIT NOBYPASSRLS;
2026-11-05T15:07:23.3802467Z  	    -- A member of the owning role can act as the definer, which would turn the
2026-11-05T15:07:23.3802858Z  	    -- narrow primitive into a general append path (the 0045 guard, same reason).
2026-11-05T15:07:23.3803162Z  	    DO $$ BEGIN
2026-11-05T15:07:23.3803319Z  	      IF EXISTS (
2026-11-05T15:07:23.3803497Z  	        SELECT 1 FROM pg_auth_members m
2026-11-05T15:07:23.3803772Z  	        JOIN pg_roles granted_role ON granted_role.oid = m.roleid
2026-11-05T15:07:23.3804066Z  	        WHERE granted_role.rolname = 'inv_audit_writer'
2026-11-05T15:07:23.3804304Z  	      ) THEN
2026-11-05T15:07:23.3804593Z  	        RAISE EXCEPTION 'inv_audit_writer has members; refusing denial-primitive ownership';
2026-11-05T15:07:23.3804913Z  	      END IF;
2026-11-05T15:07:23.3805069Z  	    END $$;
2026-11-05T15:07:23.3805229Z  	    DO $$ BEGIN
2026-11-05T15:07:23.3805471Z  	      CREATE ROLE inv_audit_reader NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE
2026-11-05T15:07:23.3805770Z  	        NOINHERIT NOBYPASSRLS;
2026-11-05T15:07:23.3805985Z  	    EXCEPTION WHEN duplicate_object THEN NULL;
2026-11-05T15:07:23.3806210Z  	    END $$;
2026-11-05T15:07:23.3806445Z  	    ALTER ROLE inv_audit_reader NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE
2026-11-05T15:07:23.3806737Z  	      NOINHERIT NOBYPASSRLS;
2026-11-05T15:07:23.3807026Z  	    -- Any pre-existing member at all stops the migration, not just inv_app and
2026-11-05T15:07:23.3807400Z  	    -- inv_kernel. Naming those two would only catch a direct grant: with
2026-11-05T15:07:23.3807774Z  	    -- `GRANT inv_audit_reader TO audit_bridge; GRANT audit_bridge TO inv_app` the
2026-11-05T15:07:23.3808168Z  	    -- runtime role assumes the reader transitively and the check would pass. It
2026-11-05T15:07:23.3808681Z  	    -- would also let an unrelated pre-existing login become a cross-tenant audit
2026-11-05T15:07:23.3809059Z  	    -- reader with no review. Every membership chain that reaches this role has a
2026-11-05T15:07:23.3809432Z  	    -- direct member at its head, so refusing direct members refuses the chains
2026-11-05T15:07:23.3809882Z  	    -- too -- which is why there is one guard here and not two.
2026-11-05T15:07:23.3810136Z  	    DO $$
2026-11-05T15:07:23.3810310Z  	    DECLARE members text;
2026-11-05T15:07:23.3810495Z  	    BEGIN
2026-11-05T15:07:23.3810730Z  	      SELECT string_agg(member_role.rolname, ', ' ORDER BY member_role.rolname)
2026-11-05T15:07:23.3811015Z  	        INTO members
2026-11-05T15:07:23.3811204Z  	        FROM pg_auth_members m
2026-11-05T15:07:23.3811553Z  	        JOIN pg_roles granted_role ON granted_role.oid = m.roleid
2026-11-05T15:07:23.3811851Z  	        JOIN pg_roles member_role ON member_role.oid = m.member
2026-11-05T15:07:23.3812138Z  	       WHERE granted_role.rolname = 'inv_audit_reader';
2026-11-05T15:07:23.3812387Z  	      IF members IS NOT NULL THEN
2026-11-05T15:07:23.3812587Z  	        RAISE EXCEPTION
2026-11-05T15:07:23.3812890Z  	          'inv_audit_reader already has members (%); review membership before migration', members;
2026-11-05T15:07:23.3813218Z  	      END IF;
2026-11-05T15:07:23.3813377Z  	    END $$;
2026-11-05T15:07:23.3813574Z  	    GRANT USAGE ON SCHEMA public TO inv_audit_reader;
2026-11-05T15:07:23.3813901Z  	    -- CREATE is needed only to receive ownership of the function below, and is
2026-11-05T15:07:23.3814217Z  	    -- revoked again in the same transaction.
2026-11-05T15:07:23.3814490Z  	    GRANT USAGE, CREATE ON SCHEMA public TO inv_audit_writer;
2026-11-05T15:07:23.3814758Z  	
2026-11-05T15:07:23.3814956Z  	    ALTER TABLE audit_events ENABLE ROW LEVEL SECURITY;
2026-11-05T15:07:23.3815275Z  	    -- FORCE, or the migration owner silently bypasses every policy below.
2026-11-05T15:07:23.3815601Z  	    ALTER TABLE audit_events FORCE ROW LEVEL SECURITY;
2026-11-05T15:07:23.3815936Z  	    CREATE POLICY audit_events_tenant_isolation ON audit_events FOR ALL TO inv_app
2026-11-05T15:07:23.3816328Z  	      USING (tenant_id = nullif(current_setting('inv.tenant_id',true),'')::uuid)
2026-11-05T15:07:23.3816716Z  	      WITH CHECK (tenant_id = nullif(current_setting('inv.tenant_id',true),'')::uuid);
2026-11-05T15:07:23.3817141Z  	    CREATE POLICY audit_events_denial_append ON audit_events FOR INSERT TO inv_audit_writer
2026-11-05T15:07:23.3817513Z  	      WITH CHECK (tenant_id IS NULL AND outcome = 'deny');
2026-11-05T15:07:23.3817867Z  	    CREATE POLICY audit_events_audit_read ON audit_events FOR SELECT TO inv_audit_reader
2026-11-05T15:07:23.3818183Z  	      USING (true);
2026-11-05T15:07:23.3818580Z  	    -- The application never reads audit records; it only appends them. INSERT
2026-11-05T15:07:23.3818952Z  	    -- stays, so append-only for this role is unchanged (PLAN-DB-001).
2026-11-05T15:07:23.3819257Z  	    REVOKE SELECT ON audit_events FROM inv_app;
2026-11-05T15:07:23.3819515Z  	    GRANT INSERT ON audit_events TO inv_audit_writer;
2026-11-05T15:07:23.3819783Z  	    GRANT SELECT ON audit_events TO inv_audit_reader;
2026-11-05T15:07:23.3820007Z  	
2026-11-05T15:07:23.3820240Z  	    -- The only way the application can record a denial it cannot attribute to a
2026-11-05T15:07:23.3820617Z  	    -- tenant. tenant_id, outcome and occurred_at are constants here: the caller
2026-11-05T15:07:23.3820987Z  	    -- chooses the facts of the denial, never whose row it is, whether it was an
2026-11-05T15:07:23.3821283Z  	    -- allow, or when it happened.
2026-11-05T15:07:23.3821524Z  	    CREATE FUNCTION public.record_auth_denial(
2026-11-05T15:07:23.3821756Z  	      p_event_id text,
2026-11-05T15:07:23.3821949Z  	      p_actor_type text,
2026-11-05T15:07:23.3822130Z  	      p_action text,
2026-11-05T15:07:23.3822313Z  	      p_reason_code text,
2026-11-05T15:07:23.3822504Z  	      p_actor_id text,
2026-11-05T15:07:23.3822680Z  	      p_trace_id text,
2026-11-05T15:07:23.3822862Z  	      p_target_type text,
2026-11-05T15:07:23.3823049Z  	      p_target_id text,
2026-11-05T15:07:23.3823231Z  	      p_detail jsonb,
2026-11-05T15:07:23.3823407Z  	      p_source_ip text,
2026-11-05T15:07:23.3823592Z  	      p_user_agent text
2026-11-05T15:07:23.3823767Z  	    ) RETURNS void
2026-11-05T15:07:23.3824049Z  	    LANGUAGE plpgsql
2026-11-05T15:07:23.3824231Z  	    SECURITY DEFINER
2026-11-05T15:07:23.3824494Z  	    -- Pinned, because a SECURITY DEFINER function that resolves names through
2026-11-05T15:07:23.3824865Z  	    -- the caller's search_path becomes a privilege escalation. Everything the
2026-11-05T15:07:23.3825231Z  	    -- body touches is schema-qualified, so pg_catalog alone is enough.
2026-11-05T15:07:23.3825628Z  	    SET search_path = pg_catalog
2026-11-05T15:07:23.3825830Z  	    AS $fn$
2026-11-05T15:07:23.3825988Z  	    BEGIN
2026-11-05T15:07:23.3826216Z  	      IF p_event_id IS NULL OR p_actor_type IS NULL OR p_action IS NULL
2026-11-05T15:07:23.3826499Z  	         OR p_reason_code IS NULL THEN
2026-11-05T15:07:23.3826836Z  	        RAISE EXCEPTION 'a denial record needs an event id, actor type, action and reason code'
2026-11-05T15:07:23.3827178Z  	          USING ERRCODE = '22023';
2026-11-05T15:07:23.3827379Z  	      END IF;
2026-11-05T15:07:23.3827555Z  	      INSERT INTO public.audit_events
2026-11-05T15:07:23.3827855Z  	        (event_id, occurred_at, tenant_id, actor_type, actor_id, action, outcome,
2026-11-05T15:07:23.3828238Z  	         reason_code, trace_id, target_type, target_id, detail, source_ip, user_agent)
2026-11-05T15:07:23.3828704Z  	      VALUES
2026-11-05T15:07:23.3828941Z  	        (p_event_id, clock_timestamp(), NULL, p_actor_type, p_actor_id, p_action,
2026-11-05T15:07:23.3829271Z  	         'deny', p_reason_code, p_trace_id, p_target_type, p_target_id,
2026-11-05T15:07:23.3829584Z  	         coalesce(p_detail, '{}'::jsonb), p_source_ip, p_user_agent);
2026-11-05T15:07:23.3829836Z  	    END
2026-11-05T15:07:23.3829996Z  	    $fn$;
2026-11-05T15:07:23.3830177Z  	    GRANT inv_audit_writer TO CURRENT_USER;
2026-11-05T15:07:23.3830559Z  	    ALTER FUNCTION public.record_auth_denial(text,text,text,text,text,text,text,text,jsonb,text,text)
2026-11-05T15:07:23.3830941Z  	      OWNER TO inv_audit_writer;
2026-11-05T15:07:23.3831189Z  	    REVOKE CREATE ON SCHEMA public FROM inv_audit_writer;
2026-11-05T15:07:23.3831458Z  	    REVOKE inv_audit_writer FROM CURRENT_USER;
2026-11-05T15:07:23.3831861Z  	    REVOKE ALL ON FUNCTION public.record_auth_denial(text,text,text,text,text,text,text,text,jsonb,text,text)
2026-11-05T15:07:23.3832239Z  	      FROM PUBLIC;
2026-11-05T15:07:23.3832585Z  	    GRANT EXECUTE ON FUNCTION public.record_auth_denial(text,text,text,text,text,text,text,text,jsonb,text,text)
2026-11-05T15:07:23.3832977Z  	      TO inv_app;
2026-11-05T15:07:23.3833137Z  	    
