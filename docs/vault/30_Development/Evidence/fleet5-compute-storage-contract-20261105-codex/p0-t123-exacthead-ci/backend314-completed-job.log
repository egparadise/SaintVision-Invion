2026-11-05T16:17:27.0524255Z  2026-11-05 16:05:36.641 UTC [14469] ERROR:  inv_audit_reader already has members (inv_audit_leaf_9305011169ba); review membership before migration
2026-11-05T16:17:27.0524801Z  2026-11-05 16:05:36.641 UTC [14469] CONTEXT:  PL/pgSQL function inline_code_block line 11 at RAISE
2026-11-05T16:17:27.0525151Z  2026-11-05 16:05:36.641 UTC [14469] STATEMENT:  
2026-11-05T16:17:27.0525368Z  	    DO $$ BEGIN
2026-11-05T16:17:27.0525631Z  	      CREATE ROLE inv_audit_writer NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE
2026-11-05T16:17:27.0525942Z  	        NOINHERIT NOBYPASSRLS;
2026-11-05T16:17:27.0526174Z  	    EXCEPTION WHEN duplicate_object THEN NULL;
2026-11-05T16:17:27.0526403Z  	    END $$;
2026-11-05T16:17:27.0526647Z  	    ALTER ROLE inv_audit_writer NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE
2026-11-05T16:17:27.0526948Z  	      NOINHERIT NOBYPASSRLS;
2026-11-05T16:17:27.0527259Z  	    -- A member of the owning role can act as the definer, which would turn the
2026-11-05T16:17:27.0527763Z  	    -- narrow primitive into a general append path (the 0045 guard, same reason).
2026-11-05T16:17:27.0528061Z  	    DO $$ BEGIN
2026-11-05T16:17:27.0528237Z  	      IF EXISTS (
2026-11-05T16:17:27.0528516Z  	        SELECT 1 FROM pg_auth_members m
2026-11-05T16:17:27.0528799Z  	        JOIN pg_roles granted_role ON granted_role.oid = m.roleid
2026-11-05T16:17:27.0529094Z  	        WHERE granted_role.rolname = 'inv_audit_writer'
2026-11-05T16:17:27.0529341Z  	      ) THEN
2026-11-05T16:17:27.0529626Z  	        RAISE EXCEPTION 'inv_audit_writer has members; refusing denial-primitive ownership';
2026-11-05T16:17:27.0529947Z  	      END IF;
2026-11-05T16:17:27.0530109Z  	    END $$;
2026-11-05T16:17:27.0530264Z  	    DO $$ BEGIN
2026-11-05T16:17:27.0530519Z  	      CREATE ROLE inv_audit_reader NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE
2026-11-05T16:17:27.0530822Z  	        NOINHERIT NOBYPASSRLS;
2026-11-05T16:17:27.0531052Z  	    EXCEPTION WHEN duplicate_object THEN NULL;
2026-11-05T16:17:27.0531278Z  	    END $$;
2026-11-05T16:17:27.0531516Z  	    ALTER ROLE inv_audit_reader NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE
2026-11-05T16:17:27.0531925Z  	      NOINHERIT NOBYPASSRLS;
2026-11-05T16:17:27.0532218Z  	    -- Any pre-existing member at all stops the migration, not just inv_app and
2026-11-05T16:17:27.0532604Z  	    -- inv_kernel. Naming those two would only catch a direct grant: with
2026-11-05T16:17:27.0532979Z  	    -- `GRANT inv_audit_reader TO audit_bridge; GRANT audit_bridge TO inv_app` the
2026-11-05T16:17:27.0533378Z  	    -- runtime role assumes the reader transitively and the check would pass. It
2026-11-05T16:17:27.0533766Z  	    -- would also let an unrelated pre-existing login become a cross-tenant audit
2026-11-05T16:17:27.0534157Z  	    -- reader with no review. Every membership chain that reaches this role has a
2026-11-05T16:17:27.0534530Z  	    -- direct member at its head, so refusing direct members refuses the chains
2026-11-05T16:17:27.0534871Z  	    -- too -- which is why there is one guard here and not two.
2026-11-05T16:17:27.0535127Z  	    DO $$
2026-11-05T16:17:27.0535299Z  	    DECLARE members text;
2026-11-05T16:17:27.0535491Z  	    BEGIN
2026-11-05T16:17:27.0535734Z  	      SELECT string_agg(member_role.rolname, ', ' ORDER BY member_role.rolname)
2026-11-05T16:17:27.0536029Z  	        INTO members
2026-11-05T16:17:27.0536214Z  	        FROM pg_auth_members m
2026-11-05T16:17:27.0536474Z  	        JOIN pg_roles granted_role ON granted_role.oid = m.roleid
2026-11-05T16:17:27.0536776Z  	        JOIN pg_roles member_role ON member_role.oid = m.member
2026-11-05T16:17:27.0537068Z  	       WHERE granted_role.rolname = 'inv_audit_reader';
2026-11-05T16:17:27.0537320Z  	      IF members IS NOT NULL THEN
2026-11-05T16:17:27.0537532Z  	        RAISE EXCEPTION
2026-11-05T16:17:27.0537840Z  	          'inv_audit_reader already has members (%); review membership before migration', members;
2026-11-05T16:17:27.0538168Z  	      END IF;
2026-11-05T16:17:27.0538341Z  	    END $$;
2026-11-05T16:17:27.0538542Z  	    GRANT USAGE ON SCHEMA public TO inv_audit_reader;
2026-11-05T16:17:27.0538870Z  	    -- CREATE is needed only to receive ownership of the function below, and is
2026-11-05T16:17:27.0539185Z  	    -- revoked again in the same transaction.
2026-11-05T16:17:27.0539474Z  	    GRANT USAGE, CREATE ON SCHEMA public TO inv_audit_writer;
2026-11-05T16:17:27.0539733Z  	
2026-11-05T16:17:27.0539931Z  	    ALTER TABLE audit_events ENABLE ROW LEVEL SECURITY;
2026-11-05T16:17:27.0540248Z  	    -- FORCE, or the migration owner silently bypasses every policy below.
2026-11-05T16:17:27.0540568Z  	    ALTER TABLE audit_events FORCE ROW LEVEL SECURITY;
2026-11-05T16:17:27.0540920Z  	    CREATE POLICY audit_events_tenant_isolation ON audit_events FOR ALL TO inv_app
2026-11-05T16:17:27.0541331Z  	      USING (tenant_id = nullif(current_setting('inv.tenant_id',true),'')::uuid)
2026-11-05T16:17:27.0541728Z  	      WITH CHECK (tenant_id = nullif(current_setting('inv.tenant_id',true),'')::uuid);
2026-11-05T16:17:27.0542373Z  	    CREATE POLICY audit_events_denial_append ON audit_events FOR INSERT TO inv_audit_writer
2026-11-05T16:17:27.0542755Z  	      WITH CHECK (tenant_id IS NULL AND outcome = 'deny');
2026-11-05T16:17:27.0543206Z  	    CREATE POLICY audit_events_audit_read ON audit_events FOR SELECT TO inv_audit_reader
2026-11-05T16:17:27.0543539Z  	      USING (true);
2026-11-05T16:17:27.0543813Z  	    -- The application never reads audit records; it only appends them. INSERT
2026-11-05T16:17:27.0544196Z  	    -- stays, so append-only for this role is unchanged (PLAN-DB-001).
2026-11-05T16:17:27.0544501Z  	    REVOKE SELECT ON audit_events FROM inv_app;
2026-11-05T16:17:27.0544773Z  	    GRANT INSERT ON audit_events TO inv_audit_writer;
2026-11-05T16:17:27.0545039Z  	    GRANT SELECT ON audit_events TO inv_audit_reader;
2026-11-05T16:17:27.0545271Z  	
2026-11-05T16:17:27.0546070Z  	    -- The only way the application can record a denial it cannot attribute to a
2026-11-05T16:17:27.0546461Z  	    -- tenant. tenant_id, outcome and occurred_at are constants here: the caller
2026-11-05T16:17:27.0546846Z  	    -- chooses the facts of the denial, never whose row it is, whether it was an
2026-11-05T16:17:27.0547156Z  	    -- allow, or when it happened.
2026-11-05T16:17:27.0547402Z  	    CREATE FUNCTION public.record_auth_denial(
2026-11-05T16:17:27.0547637Z  	      p_event_id text,
2026-11-05T16:17:27.0547839Z  	      p_actor_type text,
2026-11-05T16:17:27.0548033Z  	      p_action text,
2026-11-05T16:17:27.0548217Z  	      p_reason_code text,
2026-11-05T16:17:27.0548409Z  	      p_actor_id text,
2026-11-05T16:17:27.0548588Z  	      p_trace_id text,
2026-11-05T16:17:27.0548774Z  	      p_target_type text,
2026-11-05T16:17:27.0548962Z  	      p_target_id text,
2026-11-05T16:17:27.0549158Z  	      p_detail jsonb,
2026-11-05T16:17:27.0549340Z  	      p_source_ip text,
2026-11-05T16:17:27.0549535Z  	      p_user_agent text
2026-11-05T16:17:27.0549713Z  	    ) RETURNS void
2026-11-05T16:17:27.0549890Z  	    LANGUAGE plpgsql
2026-11-05T16:17:27.0550078Z  	    SECURITY DEFINER
2026-11-05T16:17:27.0550342Z  	    -- Pinned, because a SECURITY DEFINER function that resolves names through
2026-11-05T16:17:27.0550730Z  	    -- the caller's search_path becomes a privilege escalation. Everything the
2026-11-05T16:17:27.0551097Z  	    -- body touches is schema-qualified, so pg_catalog alone is enough.
2026-11-05T16:17:27.0551404Z  	    SET search_path = pg_catalog
2026-11-05T16:17:27.0551612Z  	    AS $fn$
2026-11-05T16:17:27.0551870Z  	    BEGIN
2026-11-05T16:17:27.0552098Z  	      IF p_event_id IS NULL OR p_actor_type IS NULL OR p_action IS NULL
2026-11-05T16:17:27.0552384Z  	         OR p_reason_code IS NULL THEN
2026-11-05T16:17:27.0552731Z  	        RAISE EXCEPTION 'a denial record needs an event id, actor type, action and reason code'
2026-11-05T16:17:27.0553075Z  	          USING ERRCODE = '22023';
2026-11-05T16:17:27.0553285Z  	      END IF;
2026-11-05T16:17:27.0553466Z  	      INSERT INTO public.audit_events
2026-11-05T16:17:27.0553775Z  	        (event_id, occurred_at, tenant_id, actor_type, actor_id, action, outcome,
2026-11-05T16:17:27.0554165Z  	         reason_code, trace_id, target_type, target_id, detail, source_ip, user_agent)
2026-11-05T16:17:27.0554473Z  	      VALUES
2026-11-05T16:17:27.0554717Z  	        (p_event_id, clock_timestamp(), NULL, p_actor_type, p_actor_id, p_action,
2026-11-05T16:17:27.0555068Z  	         'deny', p_reason_code, p_trace_id, p_target_type, p_target_id,
2026-11-05T16:17:27.0555389Z  	         coalesce(p_detail, '{}'::jsonb), p_source_ip, p_user_agent);
2026-11-05T16:17:27.0555654Z  	    END
2026-11-05T16:17:27.0555837Z  	    $fn$;
2026-11-05T16:17:27.0556021Z  	    GRANT inv_audit_writer TO CURRENT_USER;
2026-11-05T16:17:27.0556419Z  	    ALTER FUNCTION public.record_auth_denial(text,text,text,text,text,text,text,text,jsonb,text,text)
2026-11-05T16:17:27.0556799Z  	      OWNER TO inv_audit_writer;
2026-11-05T16:17:27.0557058Z  	    REVOKE CREATE ON SCHEMA public FROM inv_audit_writer;
2026-11-05T16:17:27.0557591Z  	    REVOKE inv_audit_writer FROM CURRENT_USER;
2026-11-05T16:17:27.0558001Z  	    REVOKE ALL ON FUNCTION public.record_auth_denial(text,text,text,text,text,text,text,text,jsonb,text,text)
2026-11-05T16:17:27.0558480Z  	      FROM PUBLIC;
2026-11-05T16:17:27.0558838Z  	    GRANT EXECUTE ON FUNCTION public.record_auth_denial(text,text,text,text,text,text,text,text,jsonb,text,text)
2026-11-05T16:17:27.0559236Z  	      TO inv_app;
2026-11-05T16:17:27.0559406Z  	    
