2026-11-05T16:17:27.0569009Z  	      NOINHERIT NOBYPASSRLS;
2026-11-05T16:17:27.0569311Z  	    -- Any pre-existing member at all stops the migration, not just inv_app and
2026-11-05T16:17:27.0569690Z  	    -- inv_kernel. Naming those two would only catch a direct grant: with
2026-11-05T16:17:27.0570064Z  	    -- `GRANT inv_audit_reader TO audit_bridge; GRANT audit_bridge TO inv_app` the
2026-11-05T16:17:27.0570468Z  	    -- runtime role assumes the reader transitively and the check would pass. It
2026-11-05T16:17:27.0570860Z  	    -- would also let an unrelated pre-existing login become a cross-tenant audit
2026-11-05T16:17:27.0571255Z  	    -- reader with no review. Every membership chain that reaches this role has a
2026-11-05T16:17:27.0571629Z  	    -- direct member at its head, so refusing direct members refuses the chains
2026-11-05T16:17:27.0572065Z  	    -- too -- which is why there is one guard here and not two.
2026-11-05T16:17:27.0572322Z  	    DO $$
2026-11-05T16:17:27.0572627Z  	    DECLARE members text;
2026-11-05T16:17:27.0572815Z  	    BEGIN
2026-11-05T16:17:27.0573062Z  	      SELECT string_agg(member_role.rolname, ', ' ORDER BY member_role.rolname)
2026-11-05T16:17:27.0573445Z  	        INTO members
2026-11-05T16:17:27.0573635Z  	        FROM pg_auth_members m
2026-11-05T16:17:27.0573902Z  	        JOIN pg_roles granted_role ON granted_role.oid = m.roleid
2026-11-05T16:17:27.0574208Z  	        JOIN pg_roles member_role ON member_role.oid = m.member
2026-11-05T16:17:27.0574505Z  	       WHERE granted_role.rolname = 'inv_audit_reader';
2026-11-05T16:17:27.0574760Z  	      IF members IS NOT NULL THEN
2026-11-05T16:17:27.0574974Z  	        RAISE EXCEPTION
2026-11-05T16:17:27.0575286Z  	          'inv_audit_reader already has members (%); review membership before migration', members;
2026-11-05T16:17:27.0575625Z  	      END IF;
2026-11-05T16:17:27.0575791Z  	    END $$;
2026-11-05T16:17:27.0575998Z  	    GRANT USAGE ON SCHEMA public TO inv_audit_reader;
2026-11-05T16:17:27.0576336Z  	    -- CREATE is needed only to receive ownership of the function below, and is
2026-11-05T16:17:27.0576646Z  	    -- revoked again in the same transaction.
2026-11-05T16:17:27.0576939Z  	    GRANT USAGE, CREATE ON SCHEMA public TO inv_audit_writer;
2026-11-05T16:17:27.0577200Z  	
2026-11-05T16:17:27.0588215Z  	    ALTER TABLE audit_events ENABLE ROW LEVEL SECURITY;
2026-11-05T16:17:27.0588572Z  	    -- FORCE, or the migration owner silently bypasses every policy below.
2026-11-05T16:17:27.0588911Z  	    ALTER TABLE audit_events FORCE ROW LEVEL SECURITY;
2026-11-05T16:17:27.0589262Z  	    CREATE POLICY audit_events_tenant_isolation ON audit_events FOR ALL TO inv_app
2026-11-05T16:17:27.0589655Z  	      USING (tenant_id = nullif(current_setting('inv.tenant_id',true),'')::uuid)
2026-11-05T16:17:27.0590050Z  	      WITH CHECK (tenant_id = nullif(current_setting('inv.tenant_id',true),'')::uuid);
2026-11-05T16:17:27.0590477Z  	    CREATE POLICY audit_events_denial_append ON audit_events FOR INSERT TO inv_audit_writer
2026-11-05T16:17:27.0590872Z  	      WITH CHECK (tenant_id IS NULL AND outcome = 'deny');
2026-11-05T16:17:27.0591224Z  	    CREATE POLICY audit_events_audit_read ON audit_events FOR SELECT TO inv_audit_reader
2026-11-05T16:17:27.0591558Z  	      USING (true);
2026-11-05T16:17:27.0591925Z  	    -- The application never reads audit records; it only appends them. INSERT
2026-11-05T16:17:27.0592310Z  	    -- stays, so append-only for this role is unchanged (PLAN-DB-001).
2026-11-05T16:17:27.0592613Z  	    REVOKE SELECT ON audit_events FROM inv_app;
2026-11-05T16:17:27.0592875Z  	    GRANT INSERT ON audit_events TO inv_audit_writer;
2026-11-05T16:17:27.0593135Z  	    GRANT SELECT ON audit_events TO inv_audit_reader;
2026-11-05T16:17:27.0593354Z  	
2026-11-05T16:17:27.0593599Z  	    -- The only way the application can record a denial it cannot attribute to a
2026-11-05T16:17:27.0593977Z  	    -- tenant. tenant_id, outcome and occurred_at are constants here: the caller
2026-11-05T16:17:27.0594358Z  	    -- chooses the facts of the denial, never whose row it is, whether it was an
2026-11-05T16:17:27.0594659Z  	    -- allow, or when it happened.
2026-11-05T16:17:27.0594896Z  	    CREATE FUNCTION public.record_auth_denial(
2026-11-05T16:17:27.0595131Z  	      p_event_id text,
2026-11-05T16:17:27.0595329Z  	      p_actor_type text,
2026-11-05T16:17:27.0595518Z  	      p_action text,
2026-11-05T16:17:27.0595703Z  	      p_reason_code text,
2026-11-05T16:17:27.0595899Z  	      p_actor_id text,
2026-11-05T16:17:27.0596082Z  	      p_trace_id text,
2026-11-05T16:17:27.0596274Z  	      p_target_type text,
2026-11-05T16:17:27.0596464Z  	      p_target_id text,
2026-11-05T16:17:27.0596659Z  	      p_detail jsonb,
2026-11-05T16:17:27.0596838Z  	      p_source_ip text,
2026-11-05T16:17:27.0597025Z  	      p_user_agent text
2026-11-05T16:17:27.0597200Z  	    ) RETURNS void
2026-11-05T16:17:27.0597374Z  	    LANGUAGE plpgsql
2026-11-05T16:17:27.0597552Z  	    SECURITY DEFINER
2026-11-05T16:17:27.0597812Z  	    -- Pinned, because a SECURITY DEFINER function that resolves names through
2026-11-05T16:17:27.0598359Z  	    -- the caller's search_path becomes a privilege escalation. Everything the
2026-11-05T16:17:27.0598820Z  	    -- body touches is schema-qualified, so pg_catalog alone is enough.
2026-11-05T16:17:27.0599123Z  	    SET search_path = pg_catalog
2026-11-05T16:17:27.0599329Z  	    AS $fn$
2026-11-05T16:17:27.0599494Z  	    BEGIN
2026-11-05T16:17:27.0599723Z  	      IF p_event_id IS NULL OR p_actor_type IS NULL OR p_action IS NULL
2026-11-05T16:17:27.0600009Z  	         OR p_reason_code IS NULL THEN
2026-11-05T16:17:27.0600358Z  	        RAISE EXCEPTION 'a denial record needs an event id, actor type, action and reason code'
2026-11-05T16:17:27.0600694Z  	          USING ERRCODE = '22023';
2026-11-05T16:17:27.0600905Z  	      END IF;
2026-11-05T16:17:27.0601084Z  	      INSERT INTO public.audit_events
2026-11-05T16:17:27.0601385Z  	        (event_id, occurred_at, tenant_id, actor_type, actor_id, action, outcome,
2026-11-05T16:17:27.0601774Z  	         reason_code, trace_id, target_type, target_id, detail, source_ip, user_agent)
2026-11-05T16:17:27.0602169Z  	      VALUES
2026-11-05T16:17:27.0602422Z  	        (p_event_id, clock_timestamp(), NULL, p_actor_type, p_actor_id, p_action,
2026-11-05T16:17:27.0602777Z  	         'deny', p_reason_code, p_trace_id, p_target_type, p_target_id,
2026-11-05T16:17:27.0603102Z  	         coalesce(p_detail, '{}'::jsonb), p_source_ip, p_user_agent);
2026-11-05T16:17:27.0603371Z  	    END
2026-11-05T16:17:27.0603529Z  	    $fn$;
2026-11-05T16:17:27.0603705Z  	    GRANT inv_audit_writer TO CURRENT_USER;
2026-11-05T16:17:27.0604097Z  	    ALTER FUNCTION public.record_auth_denial(text,text,text,text,text,text,text,text,jsonb,text,text)
2026-11-05T16:17:27.0604475Z  	      OWNER TO inv_audit_writer;
2026-11-05T16:17:27.0604731Z  	    REVOKE CREATE ON SCHEMA public FROM inv_audit_writer;
2026-11-05T16:17:27.0605006Z  	    REVOKE inv_audit_writer FROM CURRENT_USER;
2026-11-05T16:17:27.0605412Z  	    REVOKE ALL ON FUNCTION public.record_auth_denial(text,text,text,text,text,text,text,text,jsonb,text,text)
2026-11-05T16:17:27.0605794Z  	      FROM PUBLIC;
2026-11-05T16:17:27.0606151Z  	    GRANT EXECUTE ON FUNCTION public.record_auth_denial(text,text,text,text,text,text,text,text,jsonb,text,text)
2026-11-05T16:17:27.0606544Z  	      TO inv_app;
2026-11-05T16:17:27.0606709Z  	    
