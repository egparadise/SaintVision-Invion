2026-11-05T16:09:19.2102426Z  	    DO $$ BEGIN
2026-11-05T16:09:19.2102684Z  	      CREATE ROLE inv_audit_reader NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE
2026-11-05T16:09:19.2102919Z  	        NOINHERIT NOBYPASSRLS;
2026-11-05T16:09:19.2103099Z  	    EXCEPTION WHEN duplicate_object THEN NULL;
2026-11-05T16:09:19.2103271Z  	    END $$;
2026-11-05T16:09:19.2103535Z  	    ALTER ROLE inv_audit_reader NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE
2026-11-05T16:09:19.2103764Z  	      NOINHERIT NOBYPASSRLS;
2026-11-05T16:09:19.2103988Z  	    -- Any pre-existing member at all stops the migration, not just inv_app and
2026-11-05T16:09:19.2104345Z  	    -- inv_kernel. Naming those two would only catch a direct grant: with
2026-11-05T16:09:19.2104617Z  	    -- `GRANT inv_audit_reader TO audit_bridge; GRANT audit_bridge TO inv_app` the
2026-11-05T16:09:19.2104916Z  	    -- runtime role assumes the reader transitively and the check would pass. It
2026-11-05T16:09:19.2105210Z  	    -- would also let an unrelated pre-existing login become a cross-tenant audit
2026-11-05T16:09:19.2105496Z  	    -- reader with no review. Every membership chain that reaches this role has a
2026-11-05T16:09:19.2105775Z  	    -- direct member at its head, so refusing direct members refuses the chains
2026-11-05T16:09:19.2106029Z  	    -- too -- which is why there is one guard here and not two.
