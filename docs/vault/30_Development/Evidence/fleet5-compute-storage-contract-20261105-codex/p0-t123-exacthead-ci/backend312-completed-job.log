2026-11-05T16:09:19.2107468Z  	        JOIN pg_roles member_role ON member_role.oid = m.member
2026-11-05T16:09:19.2107681Z  	       WHERE granted_role.rolname = 'inv_audit_reader';
2026-11-05T16:09:19.2107863Z  	      IF members IS NOT NULL THEN
2026-11-05T16:09:19.2108021Z  	        RAISE EXCEPTION
2026-11-05T16:09:19.2108379Z  	          'inv_audit_reader already has members (%); review membership before migration', members;
2026-11-05T16:09:19.2108625Z  	      END IF;
2026-11-05T16:09:19.2108751Z  	    END $$;
2026-11-05T16:09:19.2108900Z  	    GRANT USAGE ON SCHEMA public TO inv_audit_reader;
