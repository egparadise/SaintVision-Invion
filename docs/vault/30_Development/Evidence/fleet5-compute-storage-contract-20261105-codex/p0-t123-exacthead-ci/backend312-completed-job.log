2026-11-05T16:09:19.2081305Z  	    DO $$ BEGIN
2026-11-05T16:09:19.2081506Z  	      CREATE ROLE inv_audit_writer NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE
