# SaintVision Control Plane Gateway Backend Container
FROM python:3.12-slim

WORKDIR /app

# Install system utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Python backend dependencies
COPY requirements-backend.txt requirements-test.txt requirements-core.txt ./
RUN pip install --no-cache-dir -r requirements-backend.txt

# Copy application source and database configuration
COPY pyproject.toml .
COPY alembic.ini .
COPY migrations/ migrations/
COPY src/ src/
COPY services/control-plane/src/ services/control-plane/src/
COPY tools/ tools/

ENV PYTHONPATH=/app/src:/app/services/control-plane/src
ENV PORT=8080

USER 65532:65532

EXPOSE 8080

# Run production unified FastAPI control plane server
CMD ["uvicorn", "saintvision.server:create_app", "--factory", "--no-proxy-headers", "--no-access-log", "--limit-concurrency", "64", "--ws", "websockets", "--ws-max-size", "8192", "--ws-max-queue", "1", "--ws-per-message-deflate", "false", "--host", "0.0.0.0", "--port", "8080"]
