# Docker buildignore for SaintVision Intranet Portal
# Overrides root .dockerignore when building with -f deploy/intranet/portal/Dockerfile
**
!apps/web/
!apps/web/**
!packages/contracts-ts/
!packages/contracts-ts/**
!contracts/
!contracts/v1alpha1/
!contracts/v1alpha1/core.schema.json
!deploy/intranet/portal/
!deploy/intranet/portal/**
apps/web/node_modules/
apps/web/dist/
apps/web/.turbo/
**/.git
**/.github
**/*.pem
**/*.key
**/.env*
**/*.log
